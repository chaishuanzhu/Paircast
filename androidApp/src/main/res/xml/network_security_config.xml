<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted GO-IM / MinIO on a LAN may be plain http:// (the user opts in by typing the scheme). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
