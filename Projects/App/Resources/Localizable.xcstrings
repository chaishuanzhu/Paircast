    "Use a COS regional endpoint (e.g. cos.ap-guangzhou.myqcloud.com). Region can be left blank and inferred from Endpoint.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a COS regional endpoint (e.g. cos.ap-guangzhou.myqcloud.com). Region can be left blank and inferred from Endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint 填 COS 地域域名（如 cos.ap-guangzhou.myqcloud.com），Region 可留空由 Endpoint 推断。"
          }
        }
      }
    },
    "Use a Qiniu S3 endpoint (e.g. s3.cn-south-1.qiniucs.com). Custom domains are for avatar downloads only — do not put them in Endpoint.": {
      "extractionState": "manual",
      "localizations": {
